# Single production LLM provider: Groq OpenAI-compatible Chat Completions.
LLM_PROVIDER=groq
LLM_API_STYLE=openai_chat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Global fallback plus stage-specific output reservations. The smaller stage
# budgets keep individual requests compatible with Groq's 8K free-tier TPM cap.
LLM_MAX_COMPLETION_TOKENS=4096
LLM_RERANK_MAX_COMPLETION_TOKENS=512
LLM_EXTRACTOR_MAX_COMPLETION_TOKENS=1400
LLM_JUDGE_MAX_COMPLETION_TOKENS=1000
LLM_REASONING_EFFORT=low

# Production defaults used by docker-compose
DATABASE_URL=postgresql+psycopg://amrra:amrra@postgres:5432/amrra
CELERY_BROKER_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000
EXECUTE_INLINE=false

# Frontend
NEXT_PUBLIC_AMRRA_API_URL=http://localhost:8000/api/v1

# Required for the real extraction/judging agents
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-plus-05-2026
COHERE_EMBED_MODEL=embed-english-v3.0
AGENT_PROVIDER=cohere

# Production defaults used by docker-compose

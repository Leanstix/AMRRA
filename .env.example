# Single production LLM: GPT-5.6 Sol through AgentRouter's OpenAI-compatible API.
# Use the exact model ID shown for your AgentRouter account if it has a suffix/alias.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.6-sol

# Production defaults used by docker-compose
DATABASE_URL=postgresql+psycopg://amrra:amrra@postgres:5432/amrra
CELERY_BROKER_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000
EXECUTE_INLINE=false

# Frontend
NEXT_PUBLIC_AMRRA_API_URL=http://localhost:8000/api/v1

CELERY_BROKER_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000
EXECUTE_INLINE=false

# Frontend
NEXT_PUBLIC_AMRRA_API_URL=http://localhost:8000/api/v1
